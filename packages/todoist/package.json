{
  "name": "@frame-os/todoist",
  "version": "0.1.0",
  "private": true,
  "description": "Frame OS: Todoist API v1 client and two-way sync",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run",
    "check:todoist": "node --experimental-strip-types --no-warnings scripts/check-connection.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
